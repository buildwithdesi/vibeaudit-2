{
  "name": "vibeaudit-2",
  "version": "2.0.0-hackathon.1",
  "description": "Vibe Audit 2.0: deterministic security scanning of AI-generated code plus Muse Spark exploitability reasoning, plain-language proof-of-risk reports, and a verified patch loop. Meta Global AI Developer Hackathon 2026 entry.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Desmond Baker <desi@digitalalchemy.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithdesi/vibeaudit-2.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "vibeaudit2": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "scan": "node src/cli.ts scan",
    "verify": "npm run typecheck && npm run lint && npm test",
    "audit:self": "vibeaudit src --skip-sca --strict --trust-target-config"
  },
  "dependencies": {
    "@jackdog668/vibeaudit": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
